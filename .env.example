# Copy to .env and fill in. Never commit .env.

# --- Database ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# e.g. postgresql+psycopg://USER:PASSWORD@localhost:5432/DB (docker-compose overrides the host to "db")
DATABASE_URL=

# Host port for the API (defaults to 8000; change it if 8000 is already taken)
API_PORT=

# --- WhatsApp Cloud API ---
# Arbitrary string you choose; must match the one entered in the Meta app dashboard
WHATSAPP_VERIFY_TOKEN=
# Temporary or system-user access token from the Meta app dashboard
WHATSAPP_ACCESS_TOKEN=
# Phone number ID of the test number (not the phone number itself)
WHATSAPP_PHONE_NUMBER_ID=
# App secret, used to check the X-Hub-Signature-256 header (leave empty to skip in local dev)
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=

# --- Meta Model API ---
MODEL_API_KEY=
MODEL_API_BASE_URL=
# Chat model for extraction (defaults to muse-spark-1.3-contributor)
MODEL_TEXT=
